{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "EVENT_BUS",
    "RABBITMQ_URL",
    "NATS_URL",
    "INTEGRATION",
    "CI",
    "NODDDE_SLOW_TESTS",
    "TESTCONTAINERS_HOST_OVERRIDE",
    "TESTCONTAINERS_RYUK_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["INTEGRATION", "CI", "NODDDE_SLOW_TESTS"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
