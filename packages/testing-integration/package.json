    "@testcontainers/postgresql": "^10.0.0",
    "@testcontainers/rabbitmq": "^10.0.0",
    "@testcontainers/toxiproxy": "^10.0.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.23.2",
