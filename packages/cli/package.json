{
  "name": "@noddde/cli",
  "version": "1.0.0-rc.1",
  "description": "CLI tool for scaffolding noddde DDD aggregates, projections, and sagas",
  "license": "MIT",
  "author": "Nidhal Dogga",
  "homepage": "https://noddde.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogganidhal/noddde",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dogganidhal/noddde/issues"
  },
  "keywords": [
    "ddd",
    "cqrs",
    "event-sourcing",
    "cli",
    "generator",
    "scaffold",
    "typescript"
  ],
  "bin": {
    "noddde": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@noddde/core": "1.0.0-rc.1",
    "@noddde/engine": "1.0.0-rc.1",
    "@noddde/typescript-config": "0.0.0",
    "eslint": "^8.56.0",
    "vitest": "^4.1.0"
  }
}
