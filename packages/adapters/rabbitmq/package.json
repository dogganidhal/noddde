{
  "name": "@noddde/rabbitmq",
  "version": "1.0.0-rc.0",
  "description": "RabbitMQ EventBus adapter for noddde",
  "license": "MIT",
  "author": "Nidhal Dogga",
  "homepage": "https://noddde.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogganidhal/noddde",
    "directory": "packages/adapters/rabbitmq"
  },
  "bugs": {
    "url": "https://github.com/dogganidhal/noddde/issues"
  },
  "keywords": [
    "ddd",
    "cqrs",
    "event-sourcing",
    "rabbitmq",
    "amqp",
    "event-bus",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noddde/core": "1.0.0-rc.0",
    "@noddde/engine": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "amqplib": ">=0.10.0"
  },
  "devDependencies": {
    "@noddde/testing-integration": "0.0.1-rc.0",
    "@noddde/typescript-config": "0.0.0",
    "@types/amqplib": "^0.10.0",
    "amqplib": "^0.10.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
