{
  "name": "@noddde/prisma",
  "version": "1.0.0-rc.1",
  "description": "Prisma persistence adapter for noddde",
  "license": "MIT",
  "author": "Nidhal Dogga",
  "homepage": "https://noddde.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogganidhal/noddde",
    "directory": "packages/adapters/prisma"
  },
  "bugs": {
    "url": "https://github.com/dogganidhal/noddde/issues"
  },
  "keywords": [
    "ddd",
    "cqrs",
    "event-sourcing",
    "prisma",
    "typescript",
    "persistence"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:generate:integration": "prisma generate --schema prisma/integration/postgres.prisma && prisma generate --schema prisma/integration/mysql.prisma",
    "test": "prisma generate && vitest run",
    "test:coverage": "prisma generate && vitest run --coverage",
    "test:integration": "prisma generate && prisma generate --schema prisma/integration/postgres.prisma && prisma generate --schema prisma/integration/mysql.prisma && vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noddde/core": "^1.0.0-rc.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "devDependencies": {
    "@noddde/testing-integration": "0.0.1-rc.1",
    "@noddde/typescript-config": "0.0.0",
    "@prisma/client": "^6.5.0",
    "prisma": "^6.5.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
